# Additional R8 keep rules.
# Primary rules live in app/proguard-rules.pro (referenced from build.gradle.kts).

# WorkManager workers must keep their class names for reflection-based instantiation.
-keep class * extends androidx.work.ListenableWorker { *; }

# Gson-serialized app models.
-keep class com.evmcstudios.joblerio.data.** { *; }
